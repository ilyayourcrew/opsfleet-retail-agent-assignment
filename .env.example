# Copy to .env and fill in. Every value can also be passed as a normal environment variable.

# --- LLM -------------------------------------------------------------------
# gemini (default) | ollama (local, offline) | fake (deterministic scripted model for tests/demo)
RA_LLM_PROVIDER=gemini
# Free key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
RA_MODEL_PRIMARY=gemini-2.5-flash
RA_MODEL_FALLBACK=gemini-2.5-flash-lite
# Ollama (only when RA_LLM_PROVIDER=ollama)
RA_OLLAMA_MODEL=ollama_chat/qwen2.5:7b

# --- Warehouse -------------------------------------------------------------
# bigquery (default) | duckdb (offline synthetic copy of thelook_ecommerce)
RA_WAREHOUSE=bigquery
# GCP project that is billed for BigQuery jobs (the public dataset itself is free to read, you pay per byte scanned)
RA_GCP_PROJECT=
RA_BQ_DATASET=bigquery-public-data.thelook_ecommerce
# Hard cap per query (bytes). 2 GB keeps every query far inside the 1 TB/month free tier.
RA_BQ_MAX_BYTES_BILLED=2000000000

# --- Policy / budgets -----------------------------------------------------
RA_K_ANONYMITY_MIN=5
RA_BUDGET_USD_PER_QUESTION=1.0
RA_MAX_SQL_ATTEMPTS=3
# Secret used to pseudonymise customer ids (HMAC). Change it in any real deployment.
RA_PSEUDONYM_SECRET=change-me
